-- Table: Candidate

-- +-----+---------+
-- | id  | Name    |
-- +-----+---------+
-- | 1   | A       |
-- | 2   | B       |
-- | 3   | C       |
-- | 4   | D       |
-- | 5   | E       |
-- +-----+---------+  
-- Table: Vote

-- +-----+--------------+
-- | id  | CandidateId  |
-- +-----+--------------+
-- | 1   |     2        |
-- | 2   |     4        |
-- | 3   |     3        |
-- | 4   |     2        |
-- | 5   |     5        |
-- +-----+--------------+
-- id is the auto-increment primary key,
-- CandidateId is the id appeared in Candidate table.
-- Write a sql to find the name of the winning candidate, the above example will return the winner B.

-- +------+
-- | Name |
-- +------+
-- | B    |
-- +------+
-- Notes:

-- You may assume there is no tie, in other words there will be only one winning candidate

Solution 1
===========
SELECT Name
FROM Candidate
WHERE id = (
  SELECT CandidateID 
  FROM Vote
  GROUP BY CandidateID
  ORDER BY COUNT(*) DESC 
  LIMIT 1);

Solution 2
=========
WITH vote_count AS(
    SELECT
        candidateId,
        DENSE_RANK() OVER(ORDER BY COUNT(id) DESC) AS c_rank
    FROM vote 
    GROUP BY candidateId
)
SELECT
    c.name
FROM candidate c
WHERE c.id = (SELECT candidateId from vote_count WHERE c_rank = 1);
